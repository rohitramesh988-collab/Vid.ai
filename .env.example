# Database (SQLite file, works out of the box for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js v5) - generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (Claude) - powers the script/scene generation step
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI - optional, used only for real TTS voiceovers (tts-1).
# If omitted, videos are still generated with burned-in captions and background music,
# just without an AI voice track.
OPENAI_API_KEY=""

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."

NEXT_PUBLIC_APP_URL="http://localhost:3000"
