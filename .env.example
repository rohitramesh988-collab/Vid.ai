# Database (Postgres — use a local Postgres, or a free Neon/Vercel Postgres branch)
DATABASE_URL="postgresql://user:password@localhost:5432/novareach"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Seed admin account (created by `npm run prisma:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Public base URL (used for widget embed snippets)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
